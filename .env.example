# --- Cropio API auth: use EITHER API_TOKEN, OR CROPIO_LOGIN + CROPIO_PASSWORD ---
API_TOKEN=
# CROPIO_LOGIN=
# CROPIO_PASSWORD=

# --- Database (must match the db service in docker-compose.yml) ---
DB_NAME=cropio_api
DB_USERNAME=cropio
DB_PASSWORD=cropio
DB_PORT=5432
DB_SCHEMA=public
# DB_HOST is set to "db" automatically by docker-compose — do not change here
# Host port to reach Postgres from your machine (e.g. Postico). Change it if
# 5432 is already taken locally — does not affect the internal connection.
DB_HOST_PORT=5432

# --- Download settings ---
START_DOWNLOAD_YEAR=2015
DOWNLOAD_PERIOD=year
# ADDITIONAL_MODELS=SatelliteImage,Version
# Seconds to wait between sync passes in the continuous loop (default 3600 = 1h).
# e.g. 1800 = 30 min, 900 = 15 min, 86400 = once a day.
DOWNLOAD_SLEEP=3600
